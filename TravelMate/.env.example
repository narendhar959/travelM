# Public OAuth client ID; this is safe to expose to the browser through /api/auth/config.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id
# Used to authenticate the server's session cookie. Generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional comma-separated local frontend origins.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Optional: defaults to 3000.
PORT=3000
